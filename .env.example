# AeroCloud Engine — Environment Variables
# Copy to .env for local development. NEVER commit real secrets.

# PostgreSQL (with pgvector extension)
DATABASE_URL=postgresql://aerocloud:devpassword@localhost:5432/aerocloud

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# PyTorch device for the Inner Loop worker
GPU_DEVICE=cuda:0

# Filesystem path for cached models (BERT, nvdiffrast, etc.)
MODEL_CACHE_DIR=/var/cache/aerocloud/models

# Structured logging level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Global deterministic seed
SEED=42

# Required for deterministic cuBLAS GEMM on CUDA 10.2+
# (Also set at Docker + pytest level — this is the single-source-of-truth for dev shells)
CUBLAS_WORKSPACE_CONFIG=:4096:8
